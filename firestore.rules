rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Hardened Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document & Preferences
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Deny public user enumeration

      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId;

      allow delete: if isOwner(userId) && isValidId(userId);

      // Check-In & Practice History Subcollection
      match /checkIns/{checkInId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
                      && isValidId(checkInId)
                      && (!('userId' in request.resource.data) || request.resource.data.userId == userId);

        allow update: if isOwner(userId)
                      && isValidId(checkInId)
                      && (!('userId' in request.resource.data) || request.resource.data.userId == userId);

        allow delete: if isOwner(userId) && isValidId(checkInId);
      }
    }
  }
}
